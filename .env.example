# Copy to .env.local and fill in. Never commit real values.

# Site: canonical URL, whether search engines may index this deployment, admin sign-ins (comma-separated)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SITE_INDEXABLE=0
ADMIN_EMAILS=

# Database (Neon / any Postgres). Pooled for the app, direct for migrations.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Clerk: user accounts (sellers sign in; admins are the Clerk users listed in ADMIN_EMAILS)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Stripe. STRIPE_SECRET_KEY may be an account key (sk_/rk_) or an organization key (sk_org…);
# with an organization key, STRIPE_CONTEXT names the account to act on (acct_…).
STRIPE_SECRET_KEY=
STRIPE_CONTEXT=
STRIPE_WEBHOOK_SECRET=
# Optional: billing portal configuration id (written by scripts/ops/stripe-bootstrap.mjs); default portal when empty
STRIPE_PORTAL_CONFIG=
# Subscription prices (monthly plans) and one-time credit packs
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_PRO=
STRIPE_PRICE_PACK_10=
STRIPE_PRICE_PACK_50=
# Only for supervised tests: lets a non-production deployment open a live Checkout
ALLOW_LIVE_CHECKOUT_NONPROD=

# Private files (Cloudflare files worker in front of R2): uploads, generated videos, backups
FILES_BASE_URL=
FILES_SIGNING_SECRET=
FILES_API_TOKEN=

# Mail worker (owner alerts, test inbox)
MAIL_WORKER_URL=
MAIL_WORKER_TOKEN=
INBOX_INGEST_SECRET=
INBOX_READ_TOKEN=

# Operations: cron endpoints (reconcile, cleanup) and IndexNow pings
CRON_SECRET=
INDEXNOW_KEY=

# Deploy fallback (optional): the GitHub repository webhook (workflow_run) signs its calls to
# /api/hooks/github with this secret; when the Deploy workflow fails, the route POSTs the Vercel
# Deploy Hook so Vercel builds the commit itself. Leave both empty to disable the fallback.
GITHUB_WEBHOOK_SECRET=
VERCEL_DEPLOY_HOOK_URL=

# Analytics (FlowGlance public site key and site id)
NEXT_PUBLIC_FLOWGLANCE_KEY=
FLOWGLANCE_SITE_ID=

# Video generation: none (feature off), mock (instant fake output for development), replicate (real)
VIDEO_PROVIDER=none
REPLICATE_API_TOKEN=
# Secret the provider echoes back on completion callbacks so the app can trust them
VIDEO_CALLBACK_SECRET=

# Script and caption generation (Claude)
ANTHROPIC_API_KEY=
